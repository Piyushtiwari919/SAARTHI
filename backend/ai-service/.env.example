# Environment: development, test, production
ENVIRONMENT=development

# Service-to-service auth token between Node.js worker and FastAPI AI Service
# Replace with a secure random token in production
INTERNAL_SERVICE_TOKEN=dev_internal_secret_token_change_me_in_production

# AI Provider: "local" (default) or "gemini"
AI_PROVIDER=local

# Google Gemini API Configuration (only used if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROVIDER_TIMEOUT_SECONDS=30.0

# Document Upload Limits
MAX_UPLOAD_BYTES=10485760  # 10 MB (in bytes)
MAX_PDF_PAGES=10

# OCR Configuration
OCR_ENABLED=true
# Windows custom Tesseract binary path if not in system PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

