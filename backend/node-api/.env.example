# Application
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/saarthi

# Redis & Background Processing Worker
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_BACKGROUND_WORKER=false

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_change_in_production

# Storage: "local" (default) or "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/documents

# AWS S3 Configuration (only required if STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=saarthi-private-documents
# AWS credentials rely on standard AWS credential chain or IAM roles:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Internal Service-to-Service Token for FastAPI
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=dev_internal_secret_token_change_me_in_production
